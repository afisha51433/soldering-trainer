        /* =========================================================
           6. 頂部進度條與中央放大 HUD 面板即時更新
           ========================================================= */
        function renderProgressRow() {
            const container = document.getElementById('jointProgressList');
            let sum = 0;
            let count = 0;

            container.innerHTML = state.joints.map((j, idx) => {
                let cls = 'joint-pill';
                let label = `J${idx + 1}`;
                if (j.status === 'evaluated') {
                    sum += j.score;
                    count += 1;
                    label += ` · ${j.score}分`;
                    if (j.score >= 85) cls += ' done-good';
                    else if (j.score >= 65) cls += ' done-warn';
                    else cls += ' done-bad';
                } else if (idx === state.currentJointIdx) {
                    cls += ' current';
                    label += ' (進行中)';
                }
                return `<div class="${cls}">${label}</div>`;
            }).join('');

            const avgBadge = document.getElementById('avgScoreBadge');
            avgBadge.textContent = count > 0 ? `${Math.round(sum / count)} 分` : '-- 分';
        }

        function updateHUD() {
            const j = state.joints[state.currentJointIdx];
            const isRight = state.handedness === 'right';
            const ironKey = isRight ? 'J' : 'F';
            const solderKey = isRight ? 'F' : 'J';

            // 1) 預熱 / 加熱時間卡片
            const heatPct = Math.min(100, (j.heatTime / 6.5) * 100);
            document.getElementById('valHeat').textContent = `${j.heatTime.toFixed(1)}s`;
            const fillHeat = document.getElementById('fillHeat');
            const cardHeat = document.getElementById('cardHeat');
            const statusHeat = document.getElementById('statusHeat');
            fillHeat.style.width = `${heatPct}%`;

            cardHeat.className = 'meter-card';
            if (j.heatTime === 0) {
                fillHeat.style.background = '#f97316';
                statusHeat.textContent = '待加熱';
                statusHeat.style.color = '#94a3b8';
            } else if (j.heatTime < 2.5) {
                fillHeat.style.background = '#fbbf24';
                statusHeat.textContent = '預熱升溫中';
                statusHeat.style.color = '#fbbf24';
            } else if (j.heatTime <= 3.8) {
                fillHeat.style.background = '#10b981';
                cardHeat.classList.add('state-good');
                statusHeat.textContent = '★ 最佳溫度';
                statusHeat.style.color = '#34d399';
            } else if (j.heatTime <= 5.2) {
                fillHeat.style.background = '#f59e0b';
                cardHeat.classList.add('state-warn');
                statusHeat.textContent = '溫度偏高';
                statusHeat.style.color = '#fbbf24';
            } else {
                fillHeat.style.background = '#f43f5e';
                cardHeat.classList.add('state-danger');
                statusHeat.textContent = '⚠️ 過熱氧化';
                statusHeat.style.color = '#fb7185';
            }

            // 2) 焊錫量卡片
            const amt = Math.round(j.solderAmount);
            document.getElementById('valSolder').textContent = `${amt}%`;
            const fillSolder = document.getElementById('fillSolder');
            const cardSolder = document.getElementById('cardSolder');
            const statusSolder = document.getElementById('statusSolder');
            fillSolder.style.width = `${amt}%`;

            cardSolder.className = 'meter-card';
            if (amt === 0) {
                fillSolder.style.background = '#38bdf8';
                statusSolder.textContent = '未送錫';
                statusSolder.style.color = '#94a3b8';
            } else if (amt < 45) {
                fillSolder.style.background = '#38bdf8';
                statusSolder.textContent = '焊錫偏少';
                statusSolder.style.color = '#38bdf8';
            } else if (amt <= 72) {
                fillSolder.style.background = '#10b981';
                cardSolder.classList.add('state-good');
                statusSolder.textContent = '★ 完美小山';
                statusSolder.style.color = '#34d399';
            } else {
                fillSolder.style.background = '#f43f5e';
                cardSolder.classList.add('state-danger');
                statusSolder.textContent = '⚠️ 焊錫過多';
                statusSolder.style.color = '#fb7185';
            }

            // 3) 烙鐵頭潔淨卡片
            const clean = Math.round(state.ironCleanliness);
            document.getElementById('valClean').textContent = `${clean}%`;
            const fillClean = document.getElementById('fillClean');
            const cardClean = document.getElementById('cardClean');
            const statusClean = document.getElementById('statusClean');
            fillClean.style.width = `${clean}%`;

            cardClean.className = 'meter-card';
            if (clean >= 75) {
                fillClean.style.background = '#10b981';
                statusClean.textContent = '★ 潔淨光亮';
                statusClean.style.color = '#34d399';
            } else if (clean >= 45) {
                fillClean.style.background = '#f59e0b';
                cardClean.classList.add('state-warn');
                statusClean.textContent = '建議擦拭';
                statusClean.style.color = '#fbbf24';
            } else {
                fillClean.style.background = '#f43f5e';
                cardClean.classList.add('state-danger');
                statusClean.textContent = '❌ 氧化髒污';
                statusClean.style.color = '#fb7185';
            }

            // 4) 更新五步驟高亮與即時教練橫幅
            const steps = [1, 2, 3, 4, 5].map(n => document.getElementById(`step${n}`));
            steps.forEach(el => el.classList.remove('active', 'done'));

            const coach = document.getElementById('coachBanner');
            coach.className = 'coach-banner';

            if (j.status === 'evaluated') {
                steps.forEach(el => el.classList.add('done'));
                coach.classList.add('tone-emerald');
                coach.textContent = `✅ 焊點 J${j.index + 1} 已完成！可檢視診斷結果或按 Enter 進入下一點。`;
                return;
            }

            if (state.ironCleanliness < 75 && j.heatTime === 0) {
                steps[0].classList.add('active');
                coach.classList.add('tone-amber');
                coach.textContent = '💡 教練提示：焊接前請先按 Space 或點擊「濕海綿」擦亮烙鐵頭！';
            } else if (!state.ironActive && j.heatTime === 0) {
                steps[0].classList.add('done');
                steps[1].classList.add('active');
                coach.textContent = `💡 教練提示：烙鐵頭已潔淨！請長按「${ironKey}」將烙鐵靠上焊點預熱約 3 秒。`;
            } else if (state.ironActive && j.heatTime < 2.5 && !state.solderActive) {
                steps[0].classList.add('done');
                steps[1].classList.add('active');
                coach.classList.add('tone-amber');
                coach.textContent = `🔥 正在預熱焊點（${j.heatTime.toFixed(1)}s / 目標 2.5~3.8s）… 先別急著送焊錫！`;
            } else if (state.ironActive && j.heatTime >= 2.5 && amt < 45 && !state.solderActive) {
                steps[0].classList.add('done');
                steps[1].classList.add('done');
                steps[2].classList.add('active');
                coach.classList.add('tone-emerald');
                coach.textContent = `✨ 預熱完成！保持按住「${ironKey}」，現在同時長按「${solderKey}」送入焊錫絲！`;
            } else if (state.solderActive && amt < 45) {
                steps[0].classList.add('done');
                steps[1].classList.add('done');
                steps[2].classList.add('active');
                coach.textContent = `💧 焊錫熔化中（${amt}%）… 繼續送錫直到進入 45%~72% 完美小山區間！`;
            } else if (state.solderActive && amt >= 45 && amt <= 72) {
                steps[0].classList.add('done');
                steps[1].classList.add('done');
                steps[2].classList.add('done');
                steps[3].classList.add('active');
                coach.classList.add('tone-emerald');
                coach.textContent = `🎯 達到完美小山（${amt}%）！請立刻「先放開 ${solderKey}」撤離焊錫絲！`;
            } else if (amt > 72) {
                steps[3].classList.add('active');
                coach.classList.add('tone-rose');
                coach.textContent = `⚠️ 焊錫量已超過 72%（${amt}%）！快放開 ${solderKey} 並提起烙鐵 ${ironKey}！`;
            } else if (!state.solderActive && state.ironActive && amt >= 35) {
                steps[0].classList.add('done');
                steps[1].classList.add('done');
                steps[2].classList.add('done');
                steps[3].classList.add('done');
                steps[4].classList.add('active');
                coach.classList.add('tone-emerald');
                coach.textContent = `👍 焊錫已撤離！現在請放開「${ironKey}」提起電烙鐵完成焊接！`;
            } else if (j.heatTime > 5.2) {
                coach.classList.add('tone-rose');
                coach.textContent = `🥵 警告：加熱時間已超過 5.2 秒，即將過熱氧化與焦黑！`;
            }
        }

        /* =========================================================
           7. HTML5 Canvas 擬真工作台繪製引擎
           （右傾「/」烙鐵配置、對稱「\」焊錫絲與中上方濕海綿）
           ========================================================= */
        function getLayoutMetrics(w, h) {
            const isRight = state.handedness === 'right';
            // PCB 位於畫布下方 78% 處，上方保留充足空間給中央 HUD 與兩側工具
            const pcbY = h * 0.78;

            // 濕海綿配置在畫布中上方開闊處（約畫布高度 26% 處），避開中央計量區
            const sw = Math.min(124, Math.max(92, w * 0.13));
            const sh = 40;
            const margin = Math.max(14, w * 0.022);
            const spongeY = Math.max(106, h * 0.25);

            if (isRight) {
                // 右撇子模式：焊錫在左（\ 方向）、烙鐵在右（/ 方向）、濕海綿在右中上方
                return {
                    ironOnRight: true,
                    pcbY,
                    activePinX: w * 0.48,
                    pcbLeft: -20,
                    pcbWidth: w + 40,
                    spongeX: w - sw - margin,
                    spongeY,
                    spongeW: sw,
                    spongeH: sh
                };
            } else {
                // 左撇子模式：烙鐵在左（\ 方向）、焊錫在右（/ 方向）、濕海綿在左中上方
                return {
                    ironOnRight: false,
                    pcbY,
                    activePinX: w * 0.52,
                    pcbLeft: -20,
                    pcbWidth: w + 40,
                    spongeX: margin,
                    spongeY,
                    spongeW: sw,
                    spongeH: sh
                };
            }
        }

        // 繪製單一焊點（銅箔焊盤、金屬接腳、動態焊錫小山／冷焊／過熱／拉尖）
        function drawPinAndPad(c, cx, pcbY, scale, joint) {
            c.save();
            c.translate(cx, pcbY);
            c.scale(scale, scale);

            // 過熱焦黑碳化暈圈
            if (joint.overheatSeverity > 0.05) {
                const burnR = 26 + joint.overheatSeverity * 14;
                const burnGrad = c.createRadialGradient(0, 0, 10, 0, 0, burnR);
                burnGrad.addColorStop(0, `rgba(28, 25, 23, ${0.75 * joint.overheatSeverity})`);
                burnGrad.addColorStop(1, 'rgba(28, 25, 23, 0)');
                c.fillStyle = burnGrad;
                c.beginPath();
                c.ellipse(0, 0, burnR, 8, 0, 0, Math.PI * 2);
                c.fill();
            }

            // 銅箔圓形焊盤
            const padGrad = c.createLinearGradient(-22, 0, 22, 0);
            padGrad.addColorStop(0, '#b45309');
            padGrad.addColorStop(0.5, '#f59e0b');
            padGrad.addColorStop(1, '#92400e');
            c.fillStyle = padGrad;
            c.beginPath();
            c.ellipse(0, 0, 22, 5.5, 0, 0, Math.PI * 2);
            c.fill();

            // 元件垂直鍍錫接腳
            const pinGrad = c.createLinearGradient(-4.5, 0, 4.5, 0);
            pinGrad.addColorStop(0, '#94a3b8');
            pinGrad.addColorStop(0.4, '#f8fafc');
            pinGrad.addColorStop(1, '#64748b');
            c.fillStyle = pinGrad;
            c.beginPath();
            c.roundRect(-4.5, -56, 9, 56, [3, 3, 0, 0]);
            c.fill();

            // 動態焊錫形態繪製
            if (joint.solderAmount > 1) {
                const t = joint.solderAmount / 100;
                const baseHalfW = Math.min(24, 10 + t * 16);
                const peakH = Math.min(44, 10 + t * 36);

                const dullFactor = Math.min(1, Math.max(joint.overheatSeverity, joint.coldSolderSeverity * 0.85));
                const solderGrad = c.createLinearGradient(-baseHalfW, -peakH, baseHalfW, 0);
                if (dullFactor < 0.35) {
                    solderGrad.addColorStop(0, '#cbd5e1');
                    solderGrad.addColorStop(0.38, '#ffffff');
                    solderGrad.addColorStop(0.75, '#94a3b8');
                    solderGrad.addColorStop(1, '#475569');
                } else {
                    solderGrad.addColorStop(0, '#64748b');
                    solderGrad.addColorStop(0.45, '#94a3b8');
                    solderGrad.addColorStop(1, '#334155');
                }

                c.fillStyle = solderGrad;
                c.beginPath();
                c.moveTo(-baseHalfW, -1);

                const isExcess = t > 0.74;
                const ctrlX = isExcess ? baseHalfW * 1.15 : baseHalfW * 0.42;
                const ctrlY = isExcess ? -peakH * 0.95 : -peakH * 0.36;

                const icicleOnLeft = joint.sequenceError && state.handedness === 'right';
                const icicleOnRight = joint.sequenceError && state.handedness === 'left';

                if (icicleOnLeft) {
                    c.quadraticCurveTo(-baseHalfW * 0.85, -peakH * 0.45, -baseHalfW * 0.98, -peakH * 1.24);
                    c.quadraticCurveTo(-ctrlX * 0.55, -peakH * 0.92, -4.8, -peakH);
                } else {
                    c.quadraticCurveTo(-ctrlX, ctrlY, -4.8, -peakH);
                }

                c.lineTo(4.8, -peakH);

                if (icicleOnRight) {
                    c.quadraticCurveTo(ctrlX * 0.55, -peakH * 0.92, baseHalfW * 0.98, -peakH * 1.24);
                    c.quadraticCurveTo(baseHalfW * 0.85, -peakH * 0.45, baseHalfW, -1);
                } else {
                    c.quadraticCurveTo(ctrlX, ctrlY, baseHalfW, -1);
                }

                c.closePath();
                c.fill();

                if (dullFactor < 0.4) {
                    c.strokeStyle = 'rgba(255, 255, 255, 0.72)';
                    c.lineWidth = 2;
                    c.beginPath();
                    c.moveTo(-baseHalfW * 0.42, -5);
                    c.quadraticCurveTo(-ctrlX * 0.45, ctrlY * 0.85, -3.5, -peakH + 4);
                    c.stroke();
                }
            }

            c.restore();
        }

        // 繪製濕海綿清潔座（畫布中上方開闊處）
        function drawSpongeStation(c, layout) {
            const sx = layout.spongeX;
            const sy = layout.spongeY;
            const sw = layout.spongeW;
            const sh = layout.spongeH;

            spongeHitbox = { x: sx, y: sy, w: sw, h: sh };

            c.save();

            // 深色耐熱海綿盒底座
            c.fillStyle = '#1e293b';
            c.strokeStyle = 'rgba(251, 191, 36, 0.55)';
            c.lineWidth = 1.5;
            c.beginPath();
            c.roundRect(sx - 5, sy + 6, sw + 10, sh, 10);
            c.fill();
            c.stroke();

            // 黃色濕海綿本體
            const spongeGrad = c.createLinearGradient(sx, sy, sx, sy + sh);
            spongeGrad.addColorStop(0, '#fde047');
            spongeGrad.addColorStop(0.55, '#facc15');
            spongeGrad.addColorStop(1, '#ca8a04');
            c.fillStyle = spongeGrad;
            c.beginPath();
            c.roundRect(sx, sy, sw, sh - 4, 8);
            c.fill();

            // 海綿吸水孔洞細節
            c.fillStyle = 'rgba(161, 98, 7, 0.35)';
            const holes = [
                [0.2, 0.32, 2.5], [0.42, 0.25, 2], [0.68, 0.35, 2.8],
                [0.3, 0.62, 2.2], [0.55, 0.58, 2.6], [0.8, 0.55, 2.1]
            ];
            holes.forEach(([rx, ry, r]) => {
                c.beginPath();
                c.arc(sx + sw * rx, sy + (sh - 4) * ry, r, 0, Math.PI * 2);
                c.fill();
            });

            // 若烙鐵頭髒污（<75%），加上金色呼吸提示框
            if (state.ironCleanliness < 75) {
                const pulse = 0.45 + 0.45 * Math.sin(performance.now() * 0.006);
                c.strokeStyle = `rgba(253, 224, 71, ${pulse})`;
                c.lineWidth = 2.5;
                c.beginPath();
                c.roundRect(sx - 7, sy - 3, sw + 14, sh + 11, 12);
                c.stroke();
            }

            // 下方標籤
            c.fillStyle = '#fef08a';
            c.font = 'bold 11px -apple-system, BlinkMacSystemFont, "Microsoft JhengHei", sans-serif';
            c.textAlign = 'center';
            c.fillText('🧽 濕海綿 (點我 / Space)', sx + sw / 2, sy + sh + 19);

            c.restore();
        }

        // 繪製電烙鐵：
        // 右撇子模式（isRight = true）：位於右側呈「/」右傾方向（橘色握柄在右上方、烙鐵尖端朝左下方接觸焊點）
        // 左撇子模式（isRight = false）：水平鏡像翻轉，位於左側呈「\」方向（橘色握柄在左上方、烙鐵尖端朝右下方接觸焊點）
        function drawSolderingIron(c, w, h, layout) {
            c.save();

            const isRight = layout.ironOnRight;
            const activePinX = layout.activePinX;
            const pcbY = layout.pcbY;
            const dir = isRight ? 1 : -1;
            const ironAngle = 0.52; // 約 30° 傾斜角，維持在中央 HUD 下方不遮擋計量條

            let tipX, tipY;

            if (state.spongeAnimTimer > 0) {
                // 擦海綿動畫：烙鐵尖端在濕海綿上方保持右傾（或左撇子鏡像）來回擦拭
                const progress = 1 - state.spongeAnimTimer / 0.52;
                const wiggle = Math.sin(progress * Math.PI * 4) * (spongeHitbox.w * 0.24);
                tipX = spongeHitbox.x + spongeHitbox.w * (isRight ? 0.36 : 0.64) + wiggle;
                tipY = spongeHitbox.y + 8;
            } else {
                // 沿著烙鐵自身軸線（「/」或「\」）從右上方推進至焊點或退回待機位置
                const contactX = activePinX + dir * 9;
                const contactY = pcbY - 6;
                const pullBack = Math.min(76, w * 0.085);

                const restX = contactX + dir * Math.cos(ironAngle) * pullBack;
                const restY = contactY - Math.sin(ironAngle) * pullBack;

                tipX = restX + (contactX - restX) * state.ironLerp;
                tipY = restY + (contactY - restY) * state.ironLerp;
            }

            c.translate(tipX, tipY);
            if (!isRight) {
                // 左撇子模式以垂直線鏡射翻轉
                c.scale(-1, 1);
            }
            // 旋轉 -ironAngle：本地 +X 軸（套筒與橘色握把）朝右上方延伸，形成「/」右傾姿態
            c.rotate(-ironAngle);

            // 1) 烙鐵尖端（潔淨時呈銀白金屬光澤，氧化髒污時呈暗灰褐色）
            const cleanRatio = state.ironCleanliness / 100;
            const tipGrad = c.createLinearGradient(0, -5, 42, 5);
            if (cleanRatio >= 0.75) {
                tipGrad.addColorStop(0, '#f8fafc');
                tipGrad.addColorStop(0.6, '#cbd5e1');
                tipGrad.addColorStop(1, '#64748b');
            } else {
                tipGrad.addColorStop(0, '#334155');
                tipGrad.addColorStop(0.6, '#475569');
                tipGrad.addColorStop(1, '#1e293b');
            }
            c.fillStyle = tipGrad;
            c.beginPath();
            c.moveTo(0, 0);
            c.lineTo(42, -7);
            c.lineTo(42, 7);
            c.closePath();
            c.fill();

            // 加熱接觸時的微弱高溫橘紅光暈
            if (state.ironActive && state.ironLerp > 0.7) {
                c.fillStyle = 'rgba(251, 146, 60, 0.35)';
                c.beginPath();
                c.arc(6, 0, 8, 0, Math.PI * 2);
                c.fill();
            }

            // 2) 不鏽鋼加熱套筒
            const barrelGrad = c.createLinearGradient(42, -9, 42, 9);
            barrelGrad.addColorStop(0, '#94a3b8');
            barrelGrad.addColorStop(0.5, '#e2e8f0');
            barrelGrad.addColorStop(1, '#475569');
            c.fillStyle = barrelGrad;
            c.beginPath();
            c.roundRect(42, -8.5, 66, 17, 3);
            c.fill();

            // 散熱孔裝飾
            c.fillStyle = '#1e293b';
            [56, 70, 84].forEach(hx => {
                c.beginPath();
                c.arc(hx, 0, 2.5, 0, Math.PI * 2);
                c.fill();
            });

            // 3) 隔熱護環
            c.fillStyle = '#0f172a';
            c.beginPath();
            c.roundRect(106, -11, 12, 22, 4);
            c.fill();

            // 4) 橘色人體工學防滑握把（位於右上方）
            const handleGrad = c.createLinearGradient(118, -13, 118, 13);
            handleGrad.addColorStop(0, '#fb923c');
            handleGrad.addColorStop(0.5, '#ea580c');
            handleGrad.addColorStop(1, '#9a3412');
            c.fillStyle = handleGrad;
            c.beginPath();
            c.roundRect(118, -12.5, 110, 25, [5, 12, 12, 5]);
            c.fill();

            // 握把尾端護套與電源線
            c.fillStyle = '#1e293b';
            c.beginPath();
            c.roundRect(226, -7, 14, 14, 3);
            c.fill();

            c.strokeStyle = 'rgba(51, 65, 85, 0.85)';
            c.lineWidth = 4.5;
            c.beginPath();
            c.moveTo(240, 0);
            c.quadraticCurveTo(275, 4, 305, 24);
            c.stroke();

            c.restore();
        }

        // 繪製焊錫絲（右撇子模式下位於左側呈「\」角度，與右側「/」烙鐵對稱會合於焊點）
        function drawSolderWire(c, w, h, layout) {
            c.save();

            const wireOnLeft = layout.ironOnRight;
            const activePinX = layout.activePinX;
            const pcbY = layout.pcbY;
            const dir = wireOnLeft ? -1 : 1;
            const wireAngle = 0.52;

            const contactX = activePinX + dir * 9;
            const contactY = pcbY - 9;
            const pullBack = Math.min(76, w * 0.085);

            const restX = contactX + dir * Math.cos(wireAngle) * pullBack;
            const restY = contactY - Math.sin(wireAngle) * pullBack;

            const tipX = restX + (contactX - restX) * state.solderLerp;
            const tipY = restY + (contactY - restY) * state.solderLerp;

            c.translate(tipX, tipY);
            if (wireOnLeft) {
                // 右撇子模式：焊錫在左側，水平鏡像後旋轉 -wireAngle 呈「\」角度（藍管左上、錫絲右下）
                c.scale(-1, 1);
            }
            c.rotate(-wireAngle);

            // 銀色焊錫絲前端
            const wireGrad = c.createLinearGradient(0, -2.5, 110, 2.5);
            wireGrad.addColorStop(0, '#f8fafc');
            wireGrad.addColorStop(0.5, '#cbd5e1');
            wireGrad.addColorStop(1, '#94a3b8');
            c.fillStyle = wireGrad;
            c.beginPath();
            c.roundRect(0, -2.4, 110, 4.8, 2);
            c.fill();

            // 藍色手持導管握套
            const sleeveGrad = c.createLinearGradient(108, -10, 108, 10);
            sleeveGrad.addColorStop(0, '#38bdf8');
            sleeveGrad.addColorStop(1, '#0284c7');
            c.fillStyle = sleeveGrad;
            c.beginPath();
            c.roundRect(108, -10, 74, 20, 7);
            c.fill();

            // 握套文字（鏡像時自動翻正）
            c.save();
            c.translate(145, 0);
            if (wireOnLeft) c.scale(-1, 1);
            c.fillStyle = '#f0f9ff';
            c.font = 'bold 11px -apple-system, BlinkMacSystemFont, "Microsoft JhengHei", sans-serif';
            c.textAlign = 'center';
            c.fillText('Sn63 焊錫', 0, 4);
            c.restore();

            c.restore();
        }

        function drawParticles(c) {
            state.particles.forEach(p => {
                const ratio = Math.max(0, p.life / p.maxLife);
                c.fillStyle = `rgba(${p.color}, ${p.alpha * ratio})`;
                c.beginPath();
                c.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                c.fill();
            });
        }

        function renderScene() {
            const w = canvasWrapper.clientWidth;
            const h = canvasWrapper.clientHeight;
            ctx.clearRect(0, 0, w, h);

            // 1) 背景工程方格線
            ctx.strokeStyle = 'rgba(56, 189, 248, 0.055)';
            ctx.lineWidth = 1;
            const gridSize = 36;
            for (let gx = 0; gx < w; gx += gridSize) {
                ctx.beginPath();
                ctx.moveTo(gx, 0);
                ctx.lineTo(gx, h);
                ctx.stroke();
            }
            for (let gy = 0; gy < h; gy += gridSize) {
                ctx.beginPath();
                ctx.moveTo(0, gy);
                ctx.lineTo(w, gy);
                ctx.stroke();
            }

            const layout = getLayoutMetrics(w, h);
            const pcbY = layout.pcbY;
            const activePinX = layout.activePinX;
            const pinSpacing = Math.max(135, w * 0.21);

            // 2) 綠色 PCB 電路板主體
            ctx.fillStyle = '#064e3b';
            ctx.fillRect(layout.pcbLeft, pcbY + 8, layout.pcbWidth, 36);

            const pcbGrad = ctx.createLinearGradient(0, pcbY, 0, pcbY + 24);
            pcbGrad.addColorStop(0, '#10b981');
            pcbGrad.addColorStop(0.25, '#059669');
            pcbGrad.addColorStop(1, '#065f46');
            ctx.fillStyle = pcbGrad;
            ctx.fillRect(layout.pcbLeft, pcbY, layout.pcbWidth, 24);

            // PCB 裝飾走線
            ctx.strokeStyle = 'rgba(110, 231, 183, 0.25)';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(0, pcbY + 12);
            ctx.lineTo(w, pcbY + 12);
            ctx.stroke();

            // 3) 繪製 5 個焊點（J1 ~ J5）
            state.joints.forEach((joint, idx) => {
                const offsetIdx = idx - state.currentJointIdx;
                const px = activePinX + offsetIdx * pinSpacing + state.pcbSlideOffset;
                if (px < -50 || px > w + 50) return;

                const isCurrent = idx === state.currentJointIdx;
                ctx.save();
                if (!isCurrent) ctx.globalAlpha = 0.5;
                drawPinAndPad(ctx, px, pcbY, isCurrent ? 1.0 : 0.85, joint);

                ctx.fillStyle = isCurrent ? '#ecfdf5' : '#6ee7b7';
                ctx.font = 'bold 12px ui-monospace, Consolas, monospace';
                ctx.textAlign = 'center';
                ctx.fillText(`J${idx + 1}`, px, pcbY + 17);
                ctx.restore();
            });

            // 當前目標焊點上方指示標記
            const curJoint = state.joints[state.currentJointIdx];
            if (curJoint.status === 'idle') {
                const bob = Math.sin(performance.now() * 0.005) * 4;
                ctx.fillStyle = '#34d399';
                ctx.font = 'bold 12px -apple-system, BlinkMacSystemFont, "Microsoft JhengHei", sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText('▼ 目標焊點', activePinX, pcbY - 70 + bob);
            }

            // 4) 繪製中上方濕海綿清潔座
            drawSpongeStation(ctx, layout);

            // 5) 繪製煙霧與蒸氣粒子
            drawParticles(ctx);

            // 6) 繪製右傾電烙鐵與對稱焊錫絲
            drawSolderingIron(ctx, w, h, layout);
            drawSolderWire(ctx, w, h, layout);
        }

        /* =========================================================
           8. 最終「焊接檢定成績單」與縮圖渲染
           ========================================================= */
        function createJointThumbnailDataURL(joint) {
            const off = document.createElement('canvas');
            off.width = 140;
            off.height = 96;
            const octx = off.getContext('2d');

            octx.fillStyle = '#070d19';
            octx.fillRect(0, 0, 140, 96);

            octx.fillStyle = '#059669';
            octx.fillRect(0, 74, 140, 22);

            drawPinAndPad(octx, 70, 74, 1.05, joint);
            return off.toDataURL('image/png');
        }

        function openFinalReportModal() {
            const total = state.joints.reduce((acc, j) => acc + (j.score ?? 0), 0);
            const avg = Math.round(total / TOTAL_JOINTS);

            let grade = 'D';
            let rankTitle = 'D 級 · 焊接新手見習生';
            if (avg >= 92) {
                grade = 'S';
                rankTitle = 'S 級 · 金牌電子焊接大師';
            } else if (avg >= 82) {
                grade = 'A';
                rankTitle = 'A 級 · 專業產線技術士';
            } else if (avg >= 70) {
                grade = 'B';
                rankTitle = 'B 級 · 合格電子實作員';
            } else if (avg >= 55) {
                grade = 'C';
                rankTitle = 'C 級 · 基礎焊接練習生';
            }

            document.getElementById('reportGradeBadge').textContent = grade;
            document.getElementById('reportRankTitle').textContent = rankTitle;
            document.getElementById('reportAvgText').textContent = `五點總平均：${avg} 分`;

            const thumbsGrid = document.getElementById('reportThumbsGrid');
            thumbsGrid.innerHTML = state.joints.map((j, idx) => {
                const url = createJointThumbnailDataURL(j);
                const color = j.score >= 85 ? '#34d399' : j.score >= 65 ? '#fbbf24' : '#fb7185';
                return `
                    <div class="thumb-card">
                        <img src="${url}" alt="焊點 J${idx + 1}" class="thumb-canvas">
                        <div style="font-size: 12px; font-weight: 800;">J${idx + 1}</div>
                        <div style="font-size: 13px; font-weight: 900; color: ${color};">${j.score} 分</div>
                    </div>
                `;
            }).join('');

            const tips = [];
            if (state.joints.some(j => j.ironCleanAtStart < 75)) {
                tips.push('• <strong>記得先擦海綿：</strong>部分焊點開始前烙鐵頭已氧化，按 Space 擦拭可大幅提升導熱。');
            }
            if (state.joints.some(j => (j.preheatAtFirstSolder ?? 0) < 2.2)) {
                tips.push('• <strong>耐心預熱 3 秒：</strong>送焊錫前先讓烙鐵充分加熱焊盤與接腳，可避免冷焊。');
            }
            if (state.joints.some(j => j.heatTime > 5.2)) {
                tips.push('• <strong>留意加熱總時間：</strong>超過 5.2 秒容易造成焊錫氧化黯淡與焊盤焦黑。');
            }
            if (state.joints.some(j => j.sequenceError)) {
                tips.push('• <strong>注意撤離順序：</strong>務必「先放開焊錫絲、再提起電烙鐵」，才不會拉出尖刺。');
            }
            if (tips.length === 0) {
                tips.push('• <strong>太厲害了！</strong>你的預熱節奏、焊錫量控制與撤離順序都非常標準，歡迎切換至「🏆 實戰測驗模式」挑戰無計量條盲測！');
            }

            document.getElementById('reportAdviceBox').innerHTML =
                `<div style="font-weight: 800; color: #38bdf8; margin-bottom: 4px;">📋 教練綜合講評與建議：</div>` +
                tips.join('<br>');

            document.getElementById('reportModal').classList.remove('hidden');
        }

        /* =========================================================
           9. 主遊戲動畫迴圈啟動
           ========================================================= */
        let lastTimestamp = 0;

        function gameLoop(timestamp) {
            if (!lastTimestamp) lastTimestamp = timestamp;
            const dt = Math.min(0.05, (timestamp - lastTimestamp) / 1000);
            lastTimestamp = timestamp;

            updateSimulation(dt);
            updateHUD();
            renderScene();

            requestAnimationFrame(gameLoop);
        }

        window.onload = function () {
            resizeCanvas();
            setHandedness('right');
            setMode('teach');
            renderProgressRow();
            updateHUD();
            requestAnimationFrame(gameLoop);
        };
    </script>
</body>
