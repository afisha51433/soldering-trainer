<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>電子焊接模擬器 - 焊接技巧練習小遊戲</title>
    <style>
        /* =========================================================
           1. 全域設計變數與基礎重設（純原生 CSS3，零外部相依）
           ========================================================= */
        :root {
            --bg-app: #070d19;
            --bg-panel: #0f172a;
            --border-subtle: rgba(148, 163, 184, 0.22);
            --border-strong: rgba(148, 163, 184, 0.38);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft JhengHei", "PingFang TC", "Noto Sans TC", sans-serif;
            --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }

        html, body {
            width: 100%;
            min-height: 100vh;
            background: radial-gradient(circle at 50% 0%, #111c33 0%, var(--bg-app) 75%);
            color: var(--text-main);
            font-family: var(--font-sans);
            overflow-x: hidden;
        }

        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 10px 14px 12px;
            gap: 8px;
        }

        button {
            font-family: inherit;
            cursor: pointer;
            border: none;
            outline: none;
            background: none;
            color: inherit;
        }

        .hidden {
            display: none !important;
        }

        /* =========================================================
           2. 頂部工具列與五點進度列
           ========================================================= */
        .app-shell {
            width: 100%;
            max-width: 1120px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex: 1;
        }

        .top-header {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            background: rgba(15, 23, 42, 0.86);
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            padding: 10px 14px;
            backdrop-filter: blur(10px);
        }

        .brand-group {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-logo {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, #f59e0b, #ea580c);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            box-shadow: 0 4px 14px rgba(234, 88, 12, 0.35);
            flex-shrink: 0;
        }

        .brand-title {
            font-size: 17px;
            font-weight: 800;
            letter-spacing: 0.4px;
            color: #f8fafc;
        }

        .brand-sub {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 1px;
        }

        .toolbar-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
        }

        .segmented-group {
            display: inline-flex;
            background: #060b14;
            padding: 3px;
            border-radius: 12px;
            border: 1px solid var(--border-subtle);
            gap: 2px;
        }

        .seg-btn {
            padding: 6px 11px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 700;
            color: var(--text-muted);
            transition: all 0.18s ease;
            white-space: nowrap;
        }

        .seg-btn:hover {
            color: #ffffff;
        }

        .seg-btn.active-sky {
            background: linear-gradient(180deg, #0ea5e9, #0284c7);
            color: #ffffff;
            box-shadow: 0 2px 8px rgba(2, 132, 199, 0.4);
        }

        .seg-btn.active-emerald {
            background: linear-gradient(180deg, #10b981, #059669);
            color: #ffffff;
            box-shadow: 0 2px 8px rgba(16, 185, 129, 0.35);
        }

        .seg-btn.active-amber {
            background: linear-gradient(180deg, #f59e0b, #d97706);
            color: #1c1917;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35);
        }

        .tool-pill-btn {
            padding: 7px 12px;
            border-radius: 11px;
            font-size: 12px;
            font-weight: 700;
            background: rgba(30, 41, 59, 0.9);
            border: 1px solid var(--border-subtle);
            color: #e2e8f0;
            transition: all 0.18s ease;
            white-space: nowrap;
        }

        .tool-pill-btn:hover {
            background: rgba(51, 65, 85, 0.95);
            border-color: var(--border-strong);
        }

        /* 焊點進度列 */
        .progress-bar-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            background: rgba(15, 23, 42, 0.72);
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            padding: 7px 14px;
        }

        .joint-pills {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .joint-pill {
            padding: 4px 11px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            font-family: var(--font-mono);
            background: rgba(30, 41, 59, 0.7);
            border: 1px solid rgba(148, 163, 184, 0.2);
            color: var(--text-muted);
            transition: all 0.2s ease;
        }

        .joint-pill.current {
            background: rgba(14, 165, 233, 0.2);
            border-color: #38bdf8;
            color: #e0f2fe;
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
        }

        .joint-pill.done-good {
            background: rgba(16, 185, 129, 0.2);
            border-color: #34d399;
            color: #a7f3d0;
        }

        .joint-pill.done-warn {
            background: rgba(245, 158, 11, 0.2);
            border-color: #fbbf24;
            color: #fde68a;
        }

        .joint-pill.done-bad {
            background: rgba(244, 63, 94, 0.2);
            border-color: #fb7185;
            color: #fecdd3;
        }

        .avg-score-box {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 600;
        }

        .avg-badge {
            padding: 3px 10px;
            border-radius: 999px;
            background: rgba(30, 41, 59, 0.95);
            border: 1px solid var(--border-strong);
            color: #f8fafc;
            font-weight: 800;
            font-family: var(--font-mono);
        }

        /* =========================================================
           3. 主畫布舞台與中央放大 HUD 計量區
           ========================================================= */
        .stage-wrapper {
            position: relative;
            width: 100%;
            height: clamp(445px, 58vh, 560px);
            background: #080f1e;
            border-radius: 20px;
            border: 1.5px solid rgba(148, 163, 184, 0.26);
            box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.65), 0 12px 30px rgba(0, 0, 0, 0.45);
            overflow: hidden;
        }

        #workbenchCanvas {
            display: block;
            width: 100%;
            height: 100%;
            touch-action: none;
        }

        /* 頂部置中五步驟導引列 */
        .step-guide-bar {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 12;
            display: flex;
            align-items: center;
            gap: 5px;
            background: rgba(7, 13, 25, 0.88);
            backdrop-filter: blur(8px);
            padding: 5px 12px;
            border-radius: 999px;
            border: 1px solid rgba(148, 163, 184, 0.28);
            pointer-events: none;
            max-width: 96%;
            overflow-x: auto;
        }

        .step-pill {
            font-size: 12px;
            font-weight: 700;
            padding: 3px 9px;
            border-radius: 999px;
            color: var(--text-muted);
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        .step-pill.active {
            background: linear-gradient(135deg, #0ea5e9, #0284c7);
            color: #ffffff;
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.45);
        }

        .step-pill.done {
            color: #34d399;
        }

        .step-sep {
            color: #475569;
            font-size: 12px;
            font-weight: 700;
        }

        /* 中央上方放大版三項計量卡片 + 即時教練提示 */
        .center-hud-cluster {
            position: absolute;
            top: 48px;
            left: 50%;
            transform: translateX(-50%);
            width: min(650px, 62%);
            z-index: 11;
            display: flex;
            flex-direction: column;
            gap: 7px;
            pointer-events: none;
        }

        .meters-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 9px;
        }

        .meter-card {
            background: rgba(11, 19, 36, 0.90);
            backdrop-filter: blur(10px);
            border: 1.5px solid rgba(148, 163, 184, 0.28);
            border-radius: 14px;
            padding: 9px 11px 8px;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.42);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .meter-card.state-good {
            border-color: rgba(52, 211, 153, 0.75);
            box-shadow: 0 0 16px rgba(16, 185, 129, 0.25);
        }

        .meter-card.state-warn {
            border-color: rgba(251, 191, 36, 0.75);
        }

        .meter-card.state-danger {
            border-color: rgba(251, 113, 133, 0.85);
            box-shadow: 0 0 16px rgba(244, 63, 94, 0.3);
        }

        .meter-header {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 4px;
            margin-bottom: 6px;
        }

        .meter-label {
            font-size: 13px;
            font-weight: 800;
            color: #e2e8f0;
            white-space: nowrap;
        }

        .meter-value {
            font-size: 16px;
            font-weight: 900;
            font-family: var(--font-mono);
            color: #ffffff;
        }

        .meter-track {
            position: relative;
            width: 100%;
            height: 13px;
            background: #1e293b;
            border-radius: 999px;
            overflow: hidden;
            border: 1px solid rgba(148, 163, 184, 0.22);
        }

        .zone-optimal {
            position: absolute;
            top: 0;
            bottom: 0;
            background: rgba(16, 185, 129, 0.34);
            border-left: 1.5px solid #34d399;
            border-right: 1.5px solid #34d399;
            z-index: 1;
        }

        .zone-danger {
            position: absolute;
            top: 0;
            bottom: 0;
            background: rgba(244, 63, 94, 0.28);
            border-left: 1px dashed rgba(251, 113, 133, 0.85);
            z-index: 1;
        }

        .zone-threshold {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #34d399;
            z-index: 2;
        }

        .meter-fill {
            position: relative;
            z-index: 3;
            height: 100%;
            width: 0%;
            border-radius: 999px;
            transition: width 0.06s linear, background 0.15s ease;
        }

        .meter-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 5px;
            font-size: 11px;
            font-weight: 700;
        }

        .meter-target {
            color: #94a3b8;
        }

        .meter-status {
            color: #38bdf8;
        }

        /* 即時教練引導橫幅 */
        .coach-banner {
            align-self: center;
            background: rgba(15, 23, 42, 0.92);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(56, 189, 248, 0.45);
            border-radius: 999px;
            padding: 5px 16px;
            font-size: 13px;
            font-weight: 700;
            color: #e0f2fe;
            text-align: center;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.38);
            max-width: 100%;
            transition: all 0.2s ease;
        }

        .coach-banner.tone-amber {
            border-color: rgba(251, 191, 36, 0.65);
            color: #fef3c7;
        }

        .coach-banner.tone-emerald {
            border-color: rgba(52, 211, 153, 0.75);
            color: #d1fae5;
            background: rgba(6, 78, 59, 0.88);
        }

        .coach-banner.tone-rose {
            border-color: rgba(251, 113, 133, 0.75);
            color: #ffe4e6;
            background: rgba(136, 19, 55, 0.88);
        }

        /* 實戰測驗模式頂部徽章 */
        .exam-mode-banner {
            position: absolute;
            top: 14px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 12;
            background: rgba(120, 53, 15, 0.88);
            border: 1px solid rgba(251, 191, 36, 0.65);
            color: #fef3c7;
            padding: 6px 16px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 800;
            pointer-events: none;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
            white-space: nowrap;
        }

        /* 單一焊點完成診斷浮動卡片 */
        .eval-toast-card {
            position: absolute;
            top: 48px;
            left: 50%;
            transform: translateX(-50%);
            width: min(440px, 90%);
            z-index: 20;
            background: rgba(15, 23, 42, 0.96);
            backdrop-filter: blur(12px);
            border: 1.5px solid rgba(56, 189, 248, 0.55);
            border-radius: 18px;
            padding: 14px 16px;
            box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65);
            animation: popIn 0.22s ease-out;
        }

        @keyframes popIn {
            from { opacity: 0; transform: translate(-50%, -8px) scale(0.96); }
            to { opacity: 1; transform: translate(-50%, 0) scale(1); }
        }

        .eval-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .eval-title {
            font-size: 15px;
            font-weight: 800;
            color: #f8fafc;
        }

        .eval-score-pill {
            font-size: 16px;
            font-weight: 900;
            font-family: var(--font-mono);
            padding: 3px 12px;
            border-radius: 999px;
        }

        .eval-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 5px;
            font-size: 13px;
            margin-bottom: 12px;
        }

        .eval-item-good { color: #6ee7b7; font-weight: 700; }
        .eval-item-warn { color: #fcd34d; }
        .eval-item-bad  { color: #fda4af; font-weight: 600; }

        .eval-actions {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }

        .btn-retry-joint {
            padding: 8px 13px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 700;
            background: rgba(51, 65, 85, 0.85);
            color: #e2e8f0;
            border: 1px solid var(--border-subtle);
        }

        .btn-retry-joint:hover {
            background: rgba(71, 85, 105, 0.95);
        }

        .btn-next-joint {
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 800;
            background: linear-gradient(135deg, #10b981, #059669);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.38);
        }

        .btn-next-joint:hover {
            filter: brightness(1.08);
        }

        /* =========================================================
           4. 下方雙手大型操作按鈕區
           ========================================================= */
        .controls-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            width: 100%;
        }

        .order-1 { order: 1; }
        .order-2 { order: 2; }
        .order-3 { order: 3; }

        .action-btn {
            position: relative;
            border-radius: 18px;
            padding: 13px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 4px;
            transition: transform 0.08s ease, box-shadow 0.08s ease, filter 0.12s ease;
            touch-action: manipulation;
        }

        .btn-solder {
            background: linear-gradient(180deg, #0ea5e9 0%, #0284c7 100%);
            color: #ffffff;
            box-shadow: 0 5px 0 #075985, 0 8px 18px rgba(2, 132, 199, 0.35);
            border: 1px solid rgba(125, 211, 252, 0.45);
        }

        .btn-sponge {
            background: linear-gradient(180deg, #fbbf24 0%, #f59e0b 100%);
            color: #1c1917;
            box-shadow: 0 5px 0 #b45309, 0 8px 18px rgba(245, 158, 11, 0.32);
            border: 1px solid rgba(253, 230, 138, 0.65);
        }

        .btn-iron {
            background: linear-gradient(180deg, #f97316 0%, #ea580c 100%);
            color: #ffffff;
            box-shadow: 0 5px 0 #9a3412, 0 8px 18px rgba(234, 88, 12, 0.35);
            border: 1px solid rgba(253, 186, 116, 0.45);
        }

        .action-btn.pressed,
        .action-btn:active {
            transform: translateY(4px);
            box-shadow: 0 1px 0 rgba(0, 0, 0, 0.5), 0 3px 8px rgba(0, 0, 0, 0.3);
            filter: brightness(1.08);
        }

        .btn-main-row {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 16px;
            font-weight: 900;
        }

        .btn-sub-row {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            font-weight: 700;
            opacity: 0.92;
        }

        .kbd-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 1px 7px;
            border-radius: 6px;
            font-family: var(--font-mono);
            font-size: 12px;
            font-weight: 900;
            background: rgba(0, 0, 0, 0.28);
            border: 1px solid rgba(255, 255, 255, 0.32);
        }

        .btn-sponge .kbd-badge {
            background: rgba(0, 0, 0, 0.14);
            border-color: rgba(28, 25, 23, 0.3);
            color: #1c1917;
        }

        .footer-tip {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            padding-top: 2px;
        }

        /* =========================================================
           5. 彈窗系統（操作說明 & 焊接檢定成績單）
           ========================================================= */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 50;
            background: rgba(2, 6, 23, 0.82);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .modal-box {
            width: 100%;
            max-width: 680px;
            max-height: 90vh;
            overflow-y: auto;
            background: #0f172a;
            border: 1.5px solid rgba(148, 163, 184, 0.35);
            border-radius: 22px;
            padding: 22px;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.75);
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .modal-title {
            font-size: 19px;
            font-weight: 900;
            color: #f8fafc;
        }

        .modal-close {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            background: rgba(30, 41, 59, 0.9);
            color: #cbd5e1;
            font-size: 16px;
            font-weight: 800;
        }

        .help-steps {
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 14px;
            line-height: 1.6;
            color: #cbd5e1;
            margin-bottom: 18px;
        }

        .help-step-item {
            display: flex;
            gap: 10px;
            background: rgba(30, 41, 59, 0.5);
            padding: 10px 12px;
            border-radius: 12px;
            border: 1px solid rgba(148, 163, 184, 0.15);
        }

        .help-num {
            font-weight: 900;
            color: #38bdf8;
            font-family: var(--font-mono);
        }

        /* 成績單專屬樣式 */
        .report-hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.18), rgba(16, 185, 129, 0.16));
            border: 1px solid rgba(56, 189, 248, 0.35);
            border-radius: 16px;
            padding: 14px 18px;
            margin-bottom: 14px;
        }

        .report-grade-badge {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            font-weight: 900;
            font-family: var(--font-mono);
            background: linear-gradient(135deg, #f59e0b, #ea580c);
            color: #ffffff;
            box-shadow: 0 6px 18px rgba(245, 158, 11, 0.4);
            flex-shrink: 0;
        }

        .thumbs-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 8px;
            margin-bottom: 14px;
        }

        .thumb-card {
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            padding: 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            text-align: center;
        }

        .thumb-canvas {
            width: 100%;
            height: 62px;
            border-radius: 8px;
            background: #070d19;
        }

        .report-advice-box {
            background: rgba(30, 41, 59, 0.65);
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            padding: 12px 14px;
            font-size: 13px;
            line-height: 1.6;
            color: #e2e8f0;
            margin-bottom: 16px;
        }

        .btn-primary-wide {
            width: 100%;
            padding: 12px;
            border-radius: 14px;
            font-size: 15px;
            font-weight: 800;
            background: linear-gradient(135deg, #0ea5e9, #0284c7);
            color: #ffffff;
