        /* =========================================================
           5. 焊接物理模擬、評分診斷與進度管理
           ========================================================= */
        function spawnSmokeParticle(isBurnt) {
            const w = canvasWrapper.clientWidth;
            const h = canvasWrapper.clientHeight;
            const layout = getLayoutMetrics(w, h);
            state.particles.push({
                x: layout.activePinX + (Math.random() - 0.5) * 14,
                y: layout.pcbY - 12,
                vx: (Math.random() - 0.5) * 26,
                vy: -28 - Math.random() * 34,
                size: 3.5 + Math.random() * 5,
                alpha: isBurnt ? 0.78 : 0.55,
                life: 0.75 + Math.random() * 0.4,
                maxLife: 1.15,
                color: isBurnt ? '120, 113, 108' : '226, 232, 240'
            });
        }

        function updateSimulation(dt) {
            const targetIron = state.ironActive ? 1 : 0;
            const targetSolder = state.solderActive ? 1 : 0;
            state.ironLerp += (targetIron - state.ironLerp) * Math.min(1, dt * 16);
            state.solderLerp += (targetSolder - state.solderLerp) * Math.min(1, dt * 16);

            if (state.spongeAnimTimer > 0) {
                state.spongeAnimTimer = Math.max(0, state.spongeAnimTimer - dt);
            }
            if (Math.abs(state.pcbSlideOffset) > 0.2) {
                state.pcbSlideOffset *= Math.pow(0.04, dt);
            } else {
                state.pcbSlideOffset = 0;
            }

            for (let i = state.particles.length - 1; i >= 0; i--) {
                const p = state.particles[i];
                p.x += p.vx * dt;
                p.y += p.vy * dt;
                p.size += 6 * dt;
                p.life -= dt;
                if (p.life <= 0) {
                    state.particles.splice(i, 1);
                }
            }

            const j = state.joints[state.currentJointIdx];
            if (j.status === 'evaluated') {
                sound.updateContinuous(false, false);
                return;
            }

            const ironTouching = state.ironActive && state.ironLerp > 0.72 && state.spongeAnimTimer <= 0;
            const solderTouching = state.solderActive && state.solderLerp > 0.72;

            if ((ironTouching || solderTouching) && j.status === 'idle') {
                j.status = 'soldering';
                j.ironCleanAtStart = state.ironCleanliness;
            }

            if (ironTouching) {
                const efficiency = 0.65 + (state.ironCleanliness / 100) * 0.35;
                j.heatTime += dt * efficiency;
                state.ironCleanliness = Math.max(15, state.ironCleanliness - dt * 3.4);

                // 超過 5.2 秒進入過熱氧化區間
                if (j.heatTime > 5.2) {
                    j.overheatSeverity = Math.min(1, j.overheatSeverity + dt * 0.6);
                }

                state.smokeTimer += dt;
                if (state.smokeTimer > (j.heatTime > 5.2 ? 0.08 : 0.18)) {
                    state.smokeTimer = 0;
                    spawnSmokeParticle(j.heatTime > 5.2);
                }
            }

            let isMelting = false;
            if (solderTouching) {
                if (ironTouching && j.heatTime >= 0.45) {
                    isMelting = true;
                    if (!j.hasFedSolder) {
                        j.hasFedSolder = true;
                        j.preheatAtFirstSolder = j.heatTime;
                    }
                    if (j.heatTime < 2.2) {
                        j.coldSolderSeverity = Math.min(1, j.coldSolderSeverity + dt * 0.85);
                    }
                    j.solderAmount = Math.min(100, j.solderAmount + dt * 34);
                } else {
                    j.hasFedSolder = true;
                    if (j.preheatAtFirstSolder === null) j.preheatAtFirstSolder = 0;
                    j.coldSolderSeverity = Math.min(1, j.coldSolderSeverity + dt * 1.1);
                    j.solderAmount = Math.min(100, j.solderAmount + dt * 14);
                }
            }

            sound.updateContinuous(ironTouching, isMelting);

            if (j.status === 'soldering' && !state.ironActive && !state.solderActive) {
                if (j.heatTime < 0.4 && j.solderAmount < 3) {
                    Object.assign(j, createFreshJoint(j.index));
                } else {
                    evaluateCurrentJoint();
                }
            }
        }

        function evaluateCurrentJoint() {
            const j = state.joints[state.currentJointIdx];
            j.status = 'evaluated';
            sound.updateContinuous(false, false);

            let score = 100;
            const feedback = [];

            // 1. 檢查烙鐵頭潔淨度
            if (j.ironCleanAtStart < 75) {
                score -= 15;
                feedback.push({ type: 'bad', text: `🧽 焊接前未清潔烙鐵頭（潔淨度僅 ${Math.round(j.ironCleanAtStart)}%）(-15)` });
            } else {
                feedback.push({ type: 'good', text: '✨ 烙鐵頭保持潔淨光亮，導熱順暢' });
            }

            // 2. 檢查預熱時間與冷焊
            const preheat = j.preheatAtFirstSolder ?? 0;
            if (!j.hasFedSolder || j.solderAmount < 8) {
                score -= 45;
                feedback.push({ type: 'bad', text: '❌ 完全未送入焊錫，形成嚴重空焊 (-45)' });
            } else if (preheat < 2.0 || j.coldSolderSeverity > 0.35) {
                score -= 25;
                feedback.push({ type: 'bad', text: `❄️ 預熱不足（僅 ${preheat.toFixed(1)}s），焊錫未充分浸潤造成冷焊 (-25)` });
            } else if (preheat < 2.4) {
                score -= 10;
                feedback.push({ type: 'warn', text: `⏱️ 預熱略短（${preheat.toFixed(1)}s），建議達 2.5~3.8s (-10)` });
            } else if (preheat > 4.2) {
                score -= 10;
                feedback.push({ type: 'warn', text: `⏱️ 預熱偏長（${preheat.toFixed(1)}s），下次可早點送錫 (-10)` });
            } else {
                feedback.push({ type: 'good', text: `🔥 預熱時機精準（${preheat.toFixed(1)}s），焊盤與接腳受熱均勻` });
            }

            // 3. 檢查過熱氧化（>5.2s）
            if (j.heatTime > 5.7 || j.overheatSeverity > 0.45) {
                score -= 25;
                feedback.push({ type: 'bad', text: `🥵 加熱過久（總計 ${j.heatTime.toFixed(1)}s），焊點氧化黯淡且焊盤焦黑 (-25)` });
            } else if (j.heatTime > 5.2) {
                score -= 12;
                feedback.push({ type: 'warn', text: `⚠️ 加熱超過 5.2s（${j.heatTime.toFixed(1)}s），焊點光澤略為黯淡 (-12)` });
            }

            // 4. 檢查焊錫量與外觀形態
            const amt = Math.round(j.solderAmount);
            if (amt >= 8 && amt < 35) {
                score -= 22;
                feedback.push({ type: 'bad', text: `📉 焊錫量過少（${amt}%），未完整包覆接腳 (-22)` });
            } else if (amt >= 35 && amt < 45) {
                score -= 10;
                feedback.push({ type: 'warn', text: `📉 焊錫略少（${amt}%），理想小山為 45%~72% (-10)` });
            } else if (amt > 82) {
                score -= 22;
                feedback.push({ type: 'bad', text: `⚪ 焊錫過多（${amt}%），鼓成圓球狀容易短路 (-22)` });
            } else if (amt > 72) {
                score -= 10;
                feedback.push({ type: 'warn', text: `⚪ 焊錫略多（${amt}%），稍微超出凹面小山 (-10)` });
            } else if (amt >= 45 && amt <= 72) {
                feedback.push({ type: 'good', text: `⛰️ 焊錫量完美（${amt}%），呈現標準光亮凹面小山` });
            }

            // 5. 檢查撤離順序（先收焊錫、再提烙鐵）
            if (j.sequenceError) {
                score -= 20;
                feedback.push({ type: 'bad', text: '⚡ 先提烙鐵再收焊錫，焊點被拉出尖刺（拉尖）(-20)' });
            }

            j.score = Math.max(0, Math.min(100, score));
            j.feedback = feedback;

            sound.playEvaluate(j.score);
            renderProgressRow();
            showEvalToast(j);
        }

