    <script>
        /* =========================================================
           1. Web Audio API 程序化音效引擎（零外部音檔相依）
           ========================================================= */
        class SolderingSoundEngine {
            constructor() {
                this.ctx = null;
                this.enabled = true;
                this.heatOsc = null;
                this.heatGain = null;
                this.sizzleNode = null;
                this.sizzleGain = null;
            }

            init() {
                if (!this.enabled) return;
                if (!this.ctx) {
                    const AudioCtx = window.AudioContext || window.webkitAudioContext;
                    if (AudioCtx) {
                        this.ctx = new AudioCtx();
                    }
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume().catch(() => {});
                }
            }

            setEnabled(flag) {
                this.enabled = flag;
                if (!flag) {
                    this.stopContinuous();
                }
            }

            // 濕海綿擦拭滋滋水蒸氣聲
            playSpongeSteam() {
                if (!this.enabled) return;
                this.init();
                if (!this.ctx) return;

                const duration = 0.45;
                const bufferSize = Math.floor(this.ctx.sampleRate * duration);
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.45));
                }

                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = this.ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.value = 2600;
                filter.Q.value = 1.4;

                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.24, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.005, this.ctx.currentTime + duration);

                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);
                noise.start();
            }

            // 持續性加熱與焊錫熔化音效更新
            updateContinuous(isHeating, isMelting) {
                if (!this.enabled || !this.ctx) {
                    this.stopContinuous();
                    return;
                }

                if (isHeating) {
                    if (!this.heatOsc) {
                        this.heatOsc = this.ctx.createOscillator();
                        this.heatGain = this.ctx.createGain();
                        this.heatOsc.type = 'sine';
                        this.heatOsc.frequency.value = 115;
                        this.heatGain.gain.value = 0.03;
                        this.heatOsc.connect(this.heatGain);
                        this.heatGain.connect(this.ctx.destination);
                        this.heatOsc.start();
                    }
                } else if (this.heatOsc) {
                    try { this.heatOsc.stop(); } catch (_) {}
                    this.heatOsc = null;
                    this.heatGain = null;
                }

                if (isMelting) {
                    if (!this.sizzleNode) {
                        const bufLen = this.ctx.sampleRate * 1;
                        const buf = this.ctx.createBuffer(1, bufLen, this.ctx.sampleRate);
                        const ch = buf.getChannelData(0);
                        for (let i = 0; i < bufLen; i++) {
                            ch[i] = (Math.random() > 0.92 ? (Math.random() * 2 - 1) : (Math.random() * 0.25 - 0.125));
                        }
                        this.sizzleNode = this.ctx.createBufferSource();
                        this.sizzleNode.buffer = buf;
                        this.sizzleNode.loop = true;

                        const hp = this.ctx.createBiquadFilter();
                        hp.type = 'highpass';
                        hp.frequency.value = 3200;

                        this.sizzleGain = this.ctx.createGain();
                        this.sizzleGain.gain.value = 0.09;

                        this.sizzleNode.connect(hp);
                        hp.connect(this.sizzleGain);
                        this.sizzleGain.connect(this.ctx.destination);
                        this.sizzleNode.start();
                    }
                } else if (this.sizzleNode) {
                    try { this.sizzleNode.stop(); } catch (_) {}
                    this.sizzleNode = null;
                    this.sizzleGain = null;
                }
            }

            stopContinuous() {
                if (this.heatOsc) {
                    try { this.heatOsc.stop(); } catch (_) {}
                    this.heatOsc = null;
                }
                if (this.sizzleNode) {
                    try { this.sizzleNode.stop(); } catch (_) {}
                    this.sizzleNode = null;
                }
            }

            // 完成焊點評分音效
            playEvaluate(score) {
                if (!this.enabled) return;
                this.init();
                if (!this.ctx) return;

                const now = this.ctx.currentTime;
                const notes = score >= 80 ? [523.25, 659.25, 783.99] : score >= 60 ? [440, 523.25] : [330, 261.63];
                notes.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.09);
                    gain.gain.setValueAtTime(0.14, now + idx * 0.09);
                    gain.gain.exponentialRampToValueAtTime(0.005, now + idx * 0.09 + 0.28);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now + idx * 0.09);
                    osc.stop(now + idx * 0.09 + 0.3);
                });
            }
        }

        const sound = new SolderingSoundEngine();

        /* =========================================================
           2. 遊戲核心狀態與物理參數定義
           ========================================================= */
        const TOTAL_JOINTS = 5;

        function createFreshJoint(index) {
            return {
                index,
                status: 'idle',           // 'idle' | 'soldering' | 'evaluated'
                heatTime: 0,              // 累計有效加熱時間（秒）
                solderAmount: 0,          // 焊錫量（0 ~ 100）
                hasFedSolder: false,      // 是否曾送入焊錫
                preheatAtFirstSolder: null, // 首次送錫時的預熱秒數
                coldSolderSeverity: 0,    // 冷焊程度（0 ~ 1）
                overheatSeverity: 0,      // 過熱氧化程度（0 ~ 1）
                sequenceError: false,     // 是否先提烙鐵再收焊錫（造成拉尖）
                ironCleanAtStart: 100,    // 開始焊接此點時的烙鐵潔淨度
                score: null,
                feedback: []
            };
        }

        const state = {
            mode: 'teach',                // 'teach' | 'exam'
            handedness: 'right',          // 'right' (預設右撇子: F焊錫/J烙鐵) | 'left' (左撇子: F烙鐵/J焊錫)
            currentJointIdx: 0,
            joints: Array.from({ length: TOTAL_JOINTS }, (_, i) => createFreshJoint(i)),
            ironCleanliness: 65,          // 初始設為 65%，引導學生養成先擦海綿習慣
            ironActive: false,
            solderActive: false,
            ironLerp: 0,                  // 烙鐵移動插值 0~1
            solderLerp: 0,                // 焊錫絲移動插值 0~1
            spongeAnimTimer: 0,           // 擦海綿動畫計時
            pcbSlideOffset: 0,            // 切換焊點時的 PCB 滑動動畫偏移
            particles: [],                // 煙霧與蒸氣粒子
            smokeTimer: 0
        };

        const inputs = {
            ironKey: false,
            ironMouse: false,
            ironBtn: false,
            solderKey: false,
            solderMouse: false,
            solderBtn: false
        };

        function syncInputState() {
            const cur = state.joints[state.currentJointIdx];
            if (cur.status === 'evaluated') {
                state.ironActive = false;
                state.solderActive = false;
                return;
            }
            const nextIron = inputs.ironKey || inputs.ironMouse || inputs.ironBtn;
            const nextSolder = inputs.solderKey || inputs.solderMouse || inputs.solderBtn;

            // 偵測「順序錯誤」：正在送焊錫時，卻先放開了烙鐵！
            if (state.ironActive && !nextIron && (state.solderActive || nextSolder) && cur.solderAmount > 12) {
                cur.sequenceError = true;
            }

            state.ironActive = nextIron;
            state.solderActive = nextSolder;
        }

        /* =========================================================
           3. DOM 元素快取與 Canvas 尺寸自適應
           ========================================================= */
        const canvasWrapper = document.getElementById('stageWrapper');
        const canvas = document.getElementById('workbenchCanvas');
        const ctx = canvas.getContext('2d');
        let spongeHitbox = { x: 0, y: 0, w: 120, h: 42 };

        function resizeCanvas() {
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            const w = canvasWrapper.clientWidth;
            const h = canvasWrapper.clientHeight;
            canvas.width = Math.floor(w * dpr);
            canvas.height = Math.floor(h * dpr);
